# Settings for infra/backup.sh. Copy to backup.env next to it (chmod 600). Never commit the real file.
# MinIO and Postgres credentials come from .env.prod via docker compose; only the off-site target is here.
# This file is SOURCED BY BASH: single-quote values with special characters, e.g. BACKUP_S3_SECRET_KEY='K0/ab+cd'.

# Off-site S3-compatible storage, e.g.
#   Backblaze B2:            https://s3.eu-central-003.backblazeb2.com
#   Hetzner Object Storage:  https://fsn1.your-objectstorage.com
# (Hetzner Storage Box is SFTP/rsync, not S3; use Object Storage with this script.)
BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# an application key restricted to the bucket below (B2: "Read and Write", this bucket only)
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# a PRIVATE bucket dedicated to these backups; enable the provider's server-side encryption on it
BACKUP_S3_BUCKET=sila-backups
# optional sub-folder inside the bucket
BACKUP_S3_PREFIX=prod

# Retention (SPEC §7): 14 daily + 8 weekly (Sunday) copies
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8

# Local staging for database dumps (the last BACKUP_KEEP_LOCAL days stay on the VPS for quick restores)
BACKUP_LOCAL_DIR=/var/backups/sila
BACKUP_KEEP_LOCAL=3

# Optional healthchecks.io (or compatible) check URL: pinged on start, success and failure
HEALTHCHECK_URL=
