# SILA Training — production environment for infra/docker-compose.yml.
# Copy to .env.prod on the server (chmod 600, owned by the deploy user). Never commit the real file.
#
# Generate secrets with HEX only (they are embedded in URLs: DATABASE_URL, MC_HOST_*):
#   openssl rand -hex 32
# Empty values are secrets you must generate; compose refuses to start while a required one is empty.

# --- domains (DNS A/AAAA records -> the VPS; Caddy gets certificates automatically) ---
APP_DOMAIN=app.example.com
FILES_DOMAIN=files.example.com
# Let's Encrypt account / expiry notices
ACME_EMAIL=ops@example.com

# --- images: normally pinned by deploy.sh in .env.images; only set here to override ---
# API_IMAGE=ghcr.io/pera14/sila-api:<git-sha>
# WEB_IMAGE=ghcr.io/pera14/sila-web:<git-sha>

# --- app settings ---
APP_TIMEZONE=Europe/Belgrade
BOOKING_CUTOFF_HOURS=6
CANCEL_CUTOFF_HOURS=6
SLOT_HORIZON_WEEKS=8
# most clients a trainer can have overlapping at once (parallel slots)
MAX_PARALLEL_SLOTS=2
# login/register/accept/forgot requests per minute per IP (SPEC §5)
AUTH_RATE_LIMIT=5

# --- PostgreSQL ---
# superuser `postgres` (maintenance, backups, restores only; the API never uses it)
POSTGRES_SUPERUSER_PASSWORD=
# application role + database, created on first boot by postgres/01-app-role.sh (owner, not superuser).
# Changing APP_DB_PASSWORD later also needs `ALTER ROLE` in the database (docs/DEPLOY.md, secret rotation).
APP_DB_NAME=sila
APP_DB_USER=sila
APP_DB_PASSWORD=

# --- auth secrets (>= 32 chars each; all different) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# derives join-link / calendar-feed tokens; rotating it invalidates every issued join link and iCal URL
JOIN_TOKEN_SECRET=
# signs the sila_session role-hint cookie; shared by api and web
SESSION_HINT_SECRET=

# --- MinIO (object storage for client documents) ---
MINIO_ROOT_USER=sila-root
MINIO_ROOT_PASSWORD=
# SSE-S3 master key: "<key-name>:<base64 of 32 random bytes>", e.g.
#   echo "sila-key:$(openssl rand -base64 32)"
# LOSING THIS KEY MAKES EVERY STORED DOCUMENT UNREADABLE. Store it in the password manager.
MINIO_KMS_SECRET_KEY=
# least-privilege user the API uses (created by minio/init.sh; only this bucket)
S3_BUCKET=sila-documents
S3_ACCESS_KEY=sila-api
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- e-mail (required: production refuses to only log e-mails) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for implicit TLS (port 465); false = STARTTLS on 587
SMTP_SECURE=false
MAIL_FROM="SILA Training <no-reply@example.com>"
