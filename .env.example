# --- runtime ---
NODE_ENV=development
PORT=3000
APP_TIMEZONE=Europe/Belgrade
BOOKING_CUTOFF_HOURS=6
CANCEL_CUTOFF_HOURS=6
SLOT_HORIZON_WEEKS=8
MAX_PARALLEL_SLOTS=2

# --- urls (dev: the web app proxies /api to the API, so both share the web origin) ---
APP_URL=http://localhost:3001
API_URL=http://localhost:3001/api

# --- database: local PostgreSQL 16 (e.g. Homebrew). Run `pnpm db:setup` once to create the role + databases.
# (Docker alternative: `pnpm dev:docker` runs infra/docker-compose.dev.yml and overrides these URLs.)
DATABASE_URL=postgresql://sila:sila@localhost:5432/sila
# API e2e tests use this database and reset its schema on every run. Unset = Testcontainers (Docker, used in CI).
TEST_DATABASE_URL=postgresql://sila:sila@localhost:5432/sila_test

# --- auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=dev-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-0123456789abcdef
# derives join-link / calendar-feed tokens: token = HMAC(secret, rowId); only sha256(token) is stored
JOIN_TOKEN_SECRET=dev-join-token-secret-change-me-0123456789
# signs the non-sensitive `sila_session` role-hint cookie; MUST match the web app's value
SESSION_HINT_SECRET=dev-session-hint-secret-change-me-012345
# login/register/accept/forgot requests per minute per IP. Production default (unset) is 5 per SPEC §5;
# relaxed here so local e2e runs do not lock you out.
AUTH_RATE_LIMIT=100

# --- files (MinIO / S3): not used until Agent B's documents module; nothing connects at boot ---
S3_ENDPOINT=http://localhost:9000
# Origin put into presigned URLs (what browsers reach). Empty = S3_ENDPOINT. Prod: https://files.<domain>
S3_PUBLIC_ENDPOINT=
S3_BUCKET=sila-documents
S3_ACCESS_KEY=sila
S3_SECRET_KEY=sila-minio-secret
S3_REGION=us-east-1

# --- email: SMTP_HOST empty = emails are printed to the API console (no Mailpit needed locally).
# Set SMTP_HOST/SMTP_PORT for real delivery (dev:docker uses Mailpit at localhost:1025, UI :8025).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SILA Training <no-reply@silatraining.local>"
